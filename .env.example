SECRET_KEY=replace-with-a-long-random-value
DATABASE_PATH=instance/procureflow.db
APP_BASE_URL=http://127.0.0.1:5000

# Gmail SMTP: enable 2-Step Verification, then create an App Password.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_FROM_NAME=ProcureFlow
SMTP_FROM_EMAIL=your-account@gmail.com
PUBLIC_SITE_ORIGIN=https://your-site.example
DEMO_ALERT_RECIPIENT=your-demo-recipient@example.com

# Permanent hosted SMS delivery (Twilio HTTPS API).
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=your-twilio-number
TWILIO_TO_NUMBER=your-verified-recipient
TWILIO_TEMPLATE=sms_appointment_reminders
